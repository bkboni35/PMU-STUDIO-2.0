rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper Primitives
    function isSignedIn() { 
      return request.auth != null; 
    }
    
    function isOwner(userId) { 
      return isSignedIn() && request.auth.uid == userId; 
    }
    
    function isAdmin() { 
      return (
        isSignedIn() && (
          (request.auth.token.email == 'bkboni35@gmail.com' && request.auth.token.email_verified == true) ||
          exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        )
      ); 
    }

    // Ping / Connection health check
    match /_connection_test_/{docId} {
      allow read, write: if true;
    }

    match /test/{docId} {
      allow read, write: if true;
    }

    // Live races and archives (real-time synchronization)
    match /live_races/{raceId} {
      allow read, write: if true;
    }

    // User profiles & settings (allows app-level authentication and admin supervision)
    match /users/{userId} {
      allow read, write: if true;

      // User favorites subcollection
      match /favorites/{favoriteId} {
        allow read, write: if true;
      }
    }

    // Admins collection
    match /admins/{adminId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
